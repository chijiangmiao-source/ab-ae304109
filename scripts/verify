#!/usr/bin/env python3
"""一次性验收服务：构建检查 → 代码测试 → 接口冒烟 → HTTP 冒烟。

按顺序穿插执行，任一步失败立即累计失败计数，最后以退出码报告：
  0  全部验收通过
  1  存在失败项

环境变量：
  BASE_URL   被测 Web 服务地址（默认 http://web:8080）；
             连不上时跳过 HTTP 冒烟（接口冒烟仍执行）。
"""

from __future__ import annotations

import json
import os
import py_compile
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from app.service import verify_spec  # noqa: E402

BASE_URL = os.environ.get("BASE_URL", "http://web:8080")
HTTP_WAIT_SECONDS = float(os.environ.get("HTTP_WAIT_SECONDS", "30"))

COMMUTATIVITY_RULES = ["f(?x, ?y) = f(?y, ?x)"]

failures: list[str] = []
passed: list[str] = []


def section(title: str) -> None:
    print("\n" + "=" * 64)
    print(f"  {title}")
    print("=" * 64, flush=True)


def check(name: str, ok: bool, detail: str = "") -> None:
    mark = "PASS" if ok else "FAIL"
    print(f"[{mark}] {name}" + (f" — {detail}" if detail else ""), flush=True)
    (passed if ok else failures).append(name)


# ---------------------------------------------------------------------------
# 1. 构建检查：全部源码可编译、关键模块可导入
# ---------------------------------------------------------------------------

def build_check() -> None:
    section("构建检查：字节码编译")
    ok = True
    for path in sorted(ROOT.glob("app/**/*.py")):
        try:
            py_compile.compile(str(path), doraise=True)
        except py_compile.PyCompileError as exc:
            ok = False
            print(f"  编译失败 {path}: {exc}")
    check("全部 app 源码可编译", ok)

    section("构建检查：模块导入")
    try:
        import app.engine  # noqa: F401
        import app.lexer  # noqa: F401
        import app.parser  # noqa: F401
        import app.rules  # noqa: F401
        import app.server  # noqa: F401
        import app.service  # noqa: F401
        check("关键模块导入成功", True)
    except Exception as exc:  # noqa: BLE001
        check("关键模块导入成功", False, repr(exc))


# ---------------------------------------------------------------------------
# 2. 代码测试
# ---------------------------------------------------------------------------

def run_unit_tests() -> None:
    section("代码测试：python3 -m unittest discover tests")
    proc = subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
        cwd=ROOT,
    )
    check("单元测试全部通过", proc.returncode == 0,
          f"returncode={proc.returncode}")


# ---------------------------------------------------------------------------
# 3. 接口冒烟：直接调用服务层，覆盖三类规定场景 + 无效
# ---------------------------------------------------------------------------

def interface_smoke() -> None:
    section("接口冒烟：交换律等价推导")
    out = verify_spec({
        "left": "f(a, b)",
        "right": "f(b, a)",
        "rules": COMMUTATIVITY_RULES,
    })
    ok = out["status"] == "equivalent" and bool(out.get("derivation"))
    check("f(a,b) ≡ f(b,a) 判定等价并附推导", ok, out.get("status", ""))
    if ok:
        rule_steps = [
            s for s in _all_rule_steps(out["derivation"])
        ]
        check("推导包含规则实例（交换律）", bool(rule_steps),
              f"{len(rule_steps)} 个规则步骤")
        check("规则实例给出变量绑定",
              any(s["detail"].get("bindings") for s in rule_steps))

    section("接口冒烟：同余嵌套展开")
    out = verify_spec({
        "left": "h(f(a, b))",
        "right": "h(f(b, a))",
        "rules": COMMUTATIVITY_RULES,
    })
    kinds = {s["kind"] for s in out.get("derivation", [])}
    check("外层靠同余、内层给规则实例",
          out["status"] == "equivalent" and "congruence" in kinds,
          out.get("status", ""))

    section("接口冒烟：饱和后的非等价")
    out = verify_spec({
        "left": "f(a, b)",
        "right": "f(a, c)",
        "rules": COMMUTATIVITY_RULES,
    })
    ok = out["status"] == "inequivalent"
    check("f(a,b) ≢ f(a,c) 饱和后判不等价", ok, out.get("status", ""))
    check("非等价结论不含旧逐步证据", ok and "derivation" not in out)
    fp1 = out.get("fingerprint", "")
    out2 = verify_spec({
        "left": "f(a, b)", "right": "f(a, c)",
        "rules": COMMUTATIVITY_RULES,
    })
    check("稳定摘要指纹哈希一致", ok and fp1 == out2.get("fingerprint"), fp1)

    section("接口冒烟：资源受限未完成")
    out = verify_spec({
        "left": "a",
        "right": "q",
        "rules": ["?x = f(?x)"],
        "node_limit": 10,
        "application_limit": 1000,
    })
    check("节点上限内未饱和 => 未完成",
          out["status"] == "incomplete", out.get("status", ""))

    out = verify_spec({
        "left": "g(a, g(b, g(c, d)))",
        "right": "g(d, g(c, g(b, a)))",
        "rules": [
            "g(?x, ?y) = g(?y, ?x)",
            "g(?x, g(?y, ?z)) = g(g(?x, ?y), ?z)",
            "g(g(?x, ?y), ?z) = g(?x, g(?y, ?z))",
        ],
        "application_limit": 3,
    })
    check("应用次数上限内未饱和 => 未完成",
          out["status"] == "incomplete", out.get("status", ""))

    section("接口冒烟：无效录入清除旧结论")
    out = verify_spec({"left": "f(?x, a)", "right": "f(b)", "rules": []})
    check("查询含未绑定变量 => 无效",
          out["status"] == "invalid", out.get("status", ""))
    check("无效结论不含等价类与证据",
          out["status"] == "invalid" and "classes" not in out
          and "derivation" not in out)
    out = verify_spec({"left": "f(a)", "right": "f(b)",
                       "rules": ["f(?x) = g(?x, ?y)"]})
    check("规则右侧引入新变量 => 无效",
          out["status"] == "invalid", out.get("status", ""))


def _all_rule_steps(steps):
    for st in steps:
        if st["kind"] == "rule":
            yield st
        for basis in st.get("detail", {}).get("child_basis", []):
            yield from _all_rule_steps(basis.get("derivation", []))


# ---------------------------------------------------------------------------
# 4. HTTP 冒烟：健康响应、页面、真实接口
# ---------------------------------------------------------------------------

def _request(method: str, path: str, payload=None, timeout: float = 5.0):
    url = BASE_URL.rstrip("/") + path
    data = None
    headers = {}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read().decode("utf-8")
        return resp.status, body


def http_smoke() -> None:
    section(f"HTTP 冒烟：等待服务 {BASE_URL}")
    deadline = time.time() + HTTP_WAIT_SECONDS
    healthy = False
    while time.time() < deadline:
        try:
            status, body = _request("GET", "/health")
            if status == 200 and json.loads(body)["status"] == "ok":
                healthy = True
                break
        except (OSError, urllib.error.URLError, ValueError):
            time.sleep(0.5)
    if not healthy:
        check("Web 服务健康响应 /health", False, "不可达，跳过 HTTP 冒烟")
        return
    check("Web 服务健康响应 /health", True)

    status, body = _request("GET", "/")
    check("页面 GET / 可访问且为 HTML",
          status == 200 and "受限代数表达式等价复核" in body)

    scenarios = [
        ("交换律等价（HTTP）",
         {"left": "f(a,b)", "right": "f(b,a)",
          "rules": COMMUTATIVITY_RULES}, "equivalent"),
        ("饱和后非等价（HTTP）",
         {"left": "f(a,b)", "right": "f(a,c)",
          "rules": COMMUTATIVITY_RULES}, "inequivalent"),
        ("资源受限未完成（HTTP）",
         {"left": "a", "right": "q", "rules": ["?x = f(?x)"],
          "node_limit": 10, "application_limit": 1000}, "incomplete"),
        ("无效录入（HTTP）",
         {"left": "f(", "right": "a", "rules": []}, "invalid"),
    ]
    for name, payload, expected in scenarios:
        try:
            status, body = _request("POST", "/api/verify", payload)
            got = json.loads(body)["status"]
            check(f"{name}: /api/verify => {expected}",
                  status == 200 and got == expected, f"got={got}")
        except Exception as exc:  # noqa: BLE001
            check(f"{name}: /api/verify => {expected}", False, repr(exc))


def main() -> int:
    print("飞控代数等价复核 —— 一次性验收（verify）")
    build_check()
    run_unit_tests()
    interface_smoke()
    http_smoke()

    section("验收汇总")
    print(f"  通过 {len(passed)} 项，失败 {len(failures)} 项")
    for name in failures:
        print(f"  ✗ {name}")
    if failures:
        print("验收结果：失败（退出码 1）")
        return 1
    print("验收结果：全部通过（退出码 0）")
    return 0


if __name__ == "__main__":
    sys.exit(main())
